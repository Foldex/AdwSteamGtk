using Gtk 4.0;
using Adw 1;

template $AdwaitaSteamGtkWindow : Adw.ApplicationWindow {
  default-width: 500;
  default-height: 800;
  title: _("Adwaita Steam Installer");

  content: Adw.ToolbarView {
    top-bar-style: raised;

    [top]
    Adw.HeaderBar {
      title-widget: Adw.ViewSwitcher view_switcher_title {
        policy: wide;
        hexpand: false;
        stack: main;
      };
      [end]
      MenuButton button_menu {
        menu-model: primary_menu;
        icon-name: "open-menu-symbolic";
        primary: true;
      }
    }

    Adw.ToastOverlay toast_overlay {
      child: Gtk.ScrolledWindow {
        child: Gtk.Box {
          orientation: vertical;
          valign: center;
          vexpand: false;
          margin-start: 40;
          margin-end: 40;
          margin-top: 0;
          margin-bottom: 50;
          spacing: 20;
          styles ["main-box"]

          Image app_icon {
            pixel-size: 128;
            icon-name: "io.github.Foldex.AdwSteamGtk-symbolic";
          }

          Adw.ViewStack main {
            vexpand: true;

            Adw.ViewStackPage main_options {
              title: "Main";
              icon-name: "preferences-system-symbolic";

              child: Box {
                orientation: vertical;
                valign: center;
                vexpand: false;
                spacing: 20;

                Adw.PreferencesGroup theme_group {
                  title: _("Theme Options");
                  Adw.ComboRow color_theme_options {
                    title: _("Color Theme");
                    tooltip-text: _("Changes the color theme of Steam's interface.");
                  }
                  Adw.ComboRow accent_color_options {
                    title: _("Accent Color");
                    tooltip-text: _("Changes the Accent Color");
                    model: StringList { strings [_("Auto"), _("Theme"), _("Blue"), _("Teal"), _("Green"), _("Yellow"), _("Orange"), _("Pink"), _("Purple"), _("Slate")] };
                  }
                  Adw.ActionRow no_rounded_corners {
                    title: _("No Rounded Corners");
                    tooltip-text: _("Removes smooth rounded corners from the interface.");
                    activatable-widget: no_rounded_corners_switch;

                    Switch no_rounded_corners_switch {
                      valign: center;
                    }
                  }
                }

                Adw.PreferencesGroup window_controls_group {
                  title: _("Window Controls Options");
                  Adw.ComboRow window_controls_options {
                    title: _("Controls Style");
                    tooltip-text: _("Changes Minimize/Maximize/Close Button Theme");
                    model: StringList { strings [_("Adwaita"), _("Breeze"), _("MacOS"), _("Windows")] };
                  }
                  Adw.ComboRow window_controls_layout_options {
                    title: _("Controls Button Layout");
                    tooltip-text: _("Changes Minimize/Maximize/Close Button Layout and Position");
                    model: StringList { strings [_("Auto"), _("Gnome"), _("KDE"), _("MacOS"), _("Pantheon"), _("Windows"), _("None")] };
                  }
                }

              };
            }

            Adw.ViewStackPage extra_options {
              title: "Extra";
              icon-name: "package-x-generic-symbolic";

              child: Box {
                orientation: vertical;
                valign: center;
                vexpand: false;
                spacing: 20;

                Adw.PreferencesGroup library_group {
                  title: _("Library Options");

                  Adw.ComboRow library_sidebar_options {
                    title: _("Library Sidebar");
                    tooltip-text: _("Changes display options for the Library's left sidebar.");
                    model: StringList { strings [_("Show"), _("Hover Only")] };
                  }

                  Adw.ActionRow {
                    title: _("Hide Library What's New Shelf");
                    tooltip-text: _("Disables display of the new updates section on top of the Library.");
                    activatable-widget: hide_whats_new_switch;

                    Switch hide_whats_new_switch {
                      valign: center;
                    }
                  }
                }

                Adw.PreferencesGroup login_group {
                  title: _("Login Options");

                  Adw.ComboRow login_qr_options {
                    title: _("QR Code Login");
                    tooltip-text: _("Changes display options for the mobile QR code in the Login dialog.");
                    model: StringList { strings [_("Show"), _("Hover Only"), _("Hide")] };
                  }
                }

                Adw.PreferencesGroup store_group {
                  title: _("Store Options");

                  Adw.ActionRow {
                    title: _("Show URL Bar");
                    tooltip-text: _("Shows the url on store pages.");
                    activatable-widget: show_url_bar_switch;

                    Switch show_url_bar_switch {
                      valign: center;
                    }
                  }
                }

              };
            }
          }

            Button install_button {
              label: _("Install");
              action-name: "win.install";
              styles ["suggested-action"]
              height-request: 40;
            }
            Button uninstall_button {
              label: _("Uninstall");
              action-name: "app.uninstall";
              styles ["destructive-action"]
              height-request: 40;
            }
        };
      };
    }
  };
}

menu primary_menu {
  section {
    item {
      label: _("_Preferences");
      action: "app.prefs";
    }
    item {
      label: _("_About AdwSteamGtk");
      action: "app.about";
    }
  }
}
